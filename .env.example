# Porta do serviço do robô
PORT=3100

# Sistema Nova Gestão RH — para onde as fichas (candidaturas) são enviadas
RH_API_URL=https://kaer-rh.duckdns.org
# Mesmo valor que estiver em RECRUTAMENTO_BOT_TOKEN no .env do sistema RH
RH_API_TOKEN=troque-por-um-segredo-forte

# Segredo que protege o webhook. A Z-API NAO assina as requisicoes que envia,
# entao sem isto qualquer um que descubra a URL cria candidatura falsa em nome
# de qualquer numero. Cadastre no painel da Z-API a URL com o segredo no fim:
#   https://seu-dominio/webhook/SEU_SEGREDO
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SEGREDO=

# Onde guardar as conversas em andamento (sobrevivem ao reinicio do servico)
ESTADO_ARQUIVO=./dados/conversas.json

# Z-API (se CONNECTOR=zapi)
ZAPI_BASE_URL=
ZAPI_TOKEN=

# WhatsApp Cloud API oficial (se CONNECTOR=cloud)
CLOUD_TOKEN=
CLOUD_PHONE_NUMBER_ID=
# token de verificação do webhook (você inventa) — usado na configuração na Meta
CLOUD_VERIFY_TOKEN=

# ── Maria Vitória (a atendente) ──────────────────────────────────────────
# Sem a chave, o robô atende pelo roteiro de sempre — nada quebra.
# Chave gratuita em aistudio.google.com (não pede cartão), 1.500/dia.
GEMINI_API_KEY=
# Para trocar pelo modelo da máquina de casa depois, sem mexer em código:
#   IA_ENDPOINT=http://SEU-PC:11434/v1/chat/completions
#   IA_MODELO=qwen3:8b
IA_MODELO=gemini-flash-lite-latest
IA_PRAZO_MS=8000

# ── Conexão com o WhatsApp ───────────────────────────────────────────────
# none    = só o simulador do RH (padrão)
# baileys = via NÃO OFICIAL, grátis, lê QR code. Use um número DEDICADO:
#           o WhatsApp pode bloqueá-lo. Serve enquanto a Meta não verifica.
# zapi    = Z-API (não oficial, paga). Defina ZAPI_BASE_URL e ZAPI_TOKEN acima.
# cloud   = via oficial da Meta (quando a verificação sair)
CONNECTOR=none

# Onde a sessão do WhatsApp fica guardada. São CREDENCIAIS: quem tiver esses
# arquivos entra no WhatsApp do robô sem ler QR nenhum. Já está no .gitignore.
# BAILEYS_SESSAO=./dados/whatsapp

# Pausa antes de responder, em ms. Responder em 200ms denuncia que é robô.
# BAILEYS_ESPERA_MIN=2000
# BAILEYS_ESPERA_MAX=5000

# ═══════════════════════════════════════════════════════════════════════════
# MÓDULO DE GASTOS — comprovante que chega por mensagem vira item na caixa
# de aprovação do sistema de obras. NADA entra direto no custo.
# ═══════════════════════════════════════════════════════════════════════════

# QUEM PODE LANÇAR. Isto é SEGURANÇA, não organização: sem a lista, quem
# descobrir o número manda uma foto e cria lançamento no financeiro da
# empresa. Vazio = ninguém (erro de configuração não abre a porta).
# No WhatsApp, o telefone com DDI e DDD. No Telegram, o id numérico da
# pessoa (o bot registra no log quando alguém não autorizado escreve).
#
# "*" = qualquer pessoa, mas SÓ de dentro dos grupos de GASTOS_GRUPOS.
# Serve para grupo fechado onde todo mundo pode lançar, e evita manter a
# lista de cada gestor. SEM GASTOS_GRUPOS o "*" é RECUSADO e o módulo fica
# inativo: ali ele valeria também para quem manda no privado.
GASTOS_AUTORIZADOS=

# DE ONDE OS COMPROVANTES VÊM. Vazio = qualquer conversa, desde que o
# remetente esteja autorizado. Preenchido, o robô só olha estes grupos e
# fica calado em todos os outros.
# Aceita o NOME do grupo (mais fácil) ou o identificador técnico:
#   WhatsApp: "Comprovantes"  ou  120363000000000000@g.us
#   Telegram: "Comprovantes"  ou  -1001234567890
# O nome é comparado sem acento e sem maiúscula. No arranque o robô diz se
# achou o grupo — se o nome estiver errado, ele avisa em vez de ficar mudo.
GASTOS_GRUPOS=

# Quanto esperar por uma descrição que vem em mensagem separada. Muita gente
# manda a foto e escreve o "o que é" logo depois — e é isso que diz de qual
# obra é o gasto. Legenda junto da foto envia na hora; foto sem legenda
# espera este tempo.
# GASTOS_ESPERA_DESCRICAO_MS=60000

# Sistema Nova Gestão Obras. O token sai em "Enviar pelo iPhone" (/m/atalho),
# aparece uma vez só e é revogável na mesma tela. Ele só cria comprovante:
# não lê nada, não lança conta, não aprova.
OBRAS_API_URL=https://novagestaoobras.duckdns.org
OBRAS_API_TOKEN=

# Mandar também valor/data/categoria como campos estruturados. Enquanto o
# endpoint aceitar só arquivo e texto, eles são ignorados sem erro. Ponha 0
# se a validação do lado de lá recusar campo desconhecido.
# OBRAS_CAMPOS_EXTRA=1

# Leitura do comprovante: usa a MESMA GEMINI_API_KEY lá de cima. Modelo
# maior que o da conversa de propósito — errar um dígito aqui custa dinheiro.
# IA_VISAO_MODELO=gemini-flash-latest
# IA_VISAO_PRAZO_MS=20000

# ── Telegram ─────────────────────────────────────────────────────────────
# Alternativa ao WhatsApp para o módulo de gastos: lê GRUPO sem risco de
# bloquear número. Token com o @BotFather (/newbot) — leva uns 5 minutos.
#
# O PASSO QUE TODO MUNDO ESQUECE: por padrão o bot só enxerga mensagens que
# o citam. Para ver os comprovantes do grupo, desligue o modo privacidade:
#   @BotFather → /mybots → seu bot → Bot Settings → Group Privacy → Turn off
# Depois REMOVA e adicione o bot no grupo de novo — a mudança não vale para
# os grupos onde ele já estava.
#
# Sobe em PARALELO ao WhatsApp, não no lugar dele.
TELEGRAM_TOKEN=

# Descobrir o identificador do grupo (e o número de quem fala nele). Ligue,
# mande um "oi" no grupo dos comprovantes, copie a linha impressa no log e
# desligue. Sem isso não há como preencher GASTOS_GRUPOS.
# GASTOS_DESCOBRIR_GRUPOS=1
